datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// MODELO DE VERIFICAÇÃO DE SAÚDE DA INFRAESTRUTURA
// ----------------------------------------------------
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_check")
}
