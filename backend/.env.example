# ==============================================================================
# OBRAS JOOY - ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na raiz do projeto:
#    cp .env.example .env (ou no PowerShell: Copy-Item .env.example .env)
# 2. Preencha as senhas e segredos com valores seguros e aleatórios.
# 3. NUNCA comite o arquivo .env no Git. O .env está no .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL 16 via Docker)
# ------------------------------------------------------------------------------
POSTGRES_DB=almoxarifado
POSTGRES_USER=almox
# ATENÇÃO: Defina uma senha forte. O Docker Compose recusará subir se estiver vazia.
POSTGRES_PASSWORD=sua_senha_segura_do_banco_aqui
# Mapeada para 5433 no host para evitar conflito com PostgreSQL local na porta 5432
POSTGRES_PORT=5433

# URL de conexão do Prisma ORM (usada pelo backend para conectar no banco)
DATABASE_URL=postgresql://almox:sua_senha_segura_do_banco_aqui@localhost:5433/almoxarifado?schema=public

# ------------------------------------------------------------------------------
# SERVIDOR BACK-END (Node.js + Fastify)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Origem permitida pelo CORS (endereço do front-end Vite)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO (JWT)
# ------------------------------------------------------------------------------
# Chave secreta de no mínimo 32 caracteres gerada aleatoriamente.
# Exemplo de comando para gerar no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_secreta_jwt_minimo_32_caracteres_aleatorios_aqui
# Tempo de expiração do token (padrão: 8h para cobrir o turno de trabalho)
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# USUÁRIO ADMINISTRADOR INICIAL (SEED)
# ------------------------------------------------------------------------------
# Utilizado apenas na primeira inicialização para criar o primeiro usuário ADMIN
ADMIN_LOGIN=admin
ADMIN_PASSWORD=sua_senha_segura_do_admin_aqui
ADMIN_NOME=Administrador do Sistema

# ------------------------------------------------------------------------------
# FEATURE FLAGS (Módulos Opcionais)
# ------------------------------------------------------------------------------
# Módulo de Orçamento de Obra (desativado por padrão conforme solicitação)
FEATURE_ORCAMENTO_ENABLED=false
